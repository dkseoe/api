# --- Gateway server ---
PORT=8000
HOST=0.0.0.0

# Optional shared secret clients must send as `Authorization: Bearer <GATEWAY_API_KEY>`.
# Leave empty to disable gateway auth.
GATEWAY_API_KEY=

# Upstreams are auto-detected from OPENROUTER_BASE_URL / OPENROUTER_API_KEY
# (the Runloop gateway uses /api/v1). To override or add more upstreams,
# set UPSTREAMS + UPSTREAM_API_KEYS explicitly:
#
# UPSTREAMS=https://gateway.runloop.ai/api/v1
# UPSTREAM_API_KEYS=sk-...

# Per-request upstream timeout (ms). 0 = no timeout.
UPSTREAM_REQUEST_TIMEOUT_MS=120000

# Maximum concurrent in-flight requests per upstream. 0 = unlimited.
MAX_CONCURRENCY_PER_UPSTREAM=64

# Total max concurrent in-flight requests across the gateway. 0 = unlimited.
MAX_CONCURRENCY_TOTAL=1024

# How long to cache the aggregated model list (ms).
MODELS_CACHE_TTL_MS=60000

# Upstream path to pull the model list from.
MODELS_PATH=/models

# Pretty-print JSON responses when text/html or ?pretty=1.
PRETTY_JSON=true

# Log level: debug | info | warn | error
LOG_LEVEL=info

# --- Provider-side prompt caching ---
# Sticky upstream routing by session_id keeps provider prompt caches warm.
# Auto-injects Anthropic top-level cache_control for anthropic models.
PROMPT_CACHE_INJECT=anthropic   # off | anthropic | all
PROMPT_CACHE_TTL=5m             # 5m | 1h (Anthropic cache_control ttl)
PROMPT_CACHE_STICKY=true

# --- Thinking-effort variant models ---
# Virtual models like anthropic/claude-opus-4.7-xhigh that bake in a reasoning
# effort level (low/medium/high/xhigh/max). The gateway rewrites the model id
# to the base and injects verbosity + reasoning.effort before proxying.
VARIANTS_ENABLED=true
VARIANT_BASES=anthropic/claude-opus-4.7,anthropic/claude-opus-4.8,anthropic/claude-fable-5
VARIANT_EFFORTS=low,medium,high,xhigh,max

# --- Per-model provider pinning (OpenRouter provider.order) ---
# Defaults pin z-ai/glm-5.2 -> siliconflow/fp8 and
# deepseek/deepseek-v4-pro -> deepseek. Override/extend here.
# MODEL_PROVIDERS=model-a=slug1|slug2,model-b=slug3
# MODEL_PROVIDER_ALLOW_FALLBACK=false
